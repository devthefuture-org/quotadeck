{
  "indicator-header": {
    "type": "header",
    "description": "Panel indicators"
  },
  "display-indicators": {
    "type": "list",
    "default": [],
    "description": "Indicators shown in the panel",
    "tooltip": "Use + to add indicators. Each row shows one provider icon and quota percentage; drag or use the arrows to reorder them.",
    "height": 240,
    "columns": [
      {
        "id": "indicator",
        "title": "Provider \u00b7 account \u00b7 quota window",
        "type": "string",
        "default": "auto",
        "options": {
          "Automatic \u2014 tightest available": "auto"
        }
      }
    ]
  },
  "display-account": {
    "type": "generic",
    "default": "auto"
  },
  "display-window": {
    "type": "generic",
    "default": "auto"
  },
  "threshold-alert-enabled": {
    "type": "switch",
    "default": true,
    "description": "Show a warning icon at the usage threshold",
    "tooltip": "Applies to the quota indicators shown in the panel. Claude icons show a red ring when their 5-hour quota is exhausted."
  },
  "threshold-alert-percent": {
    "type": "spinbutton",
    "default": 80,
    "min": 1,
    "max": 100,
    "step": 1,
    "units": "% used",
    "description": "Warning threshold",
    "dependency": "threshold-alert-enabled"
  }
}
